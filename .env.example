# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file to version control.

# --- AI provider (used from Stage 3 onward) ---
# Which provider to use: "gemini" or "groq" (both free, no credit card
# needed) or "anthropic" (Claude — requires billing set up on your account).
AI_PROVIDER=gemini

# Your API key.
#   Gemini:    aistudio.google.com/apikey
#   Groq:      console.groq.com/keys
#   Anthropic: console.anthropic.com
#   OpenAI (ChatGPT): platform.openai.com/api-keys  (AI_PROVIDER=openai)
#   Also: openrouter, deepseek, mistral, xai, or custom (any OpenAI-compatible
#   server such as Ollama — then also set AI_BASE_URL=http://localhost:11434/v1)
# Leave blank to run EV AI with AI features disabled. You can also set a
# provider-specific variable instead (GEMINI_API_KEY / GROQ_API_KEY /
# ANTHROPIC_API_KEY) and it'll be picked up automatically.
AI_API_KEY=

# Model name. Leave blank to use a sensible default for your AI_PROVIDER
# (gemini-3.8-flash for Gemini, openai/gpt-oss-120b for Groq,
# claude-sonnet-4-6 for Anthropic).
AI_MODEL=

# Vision model, used only by Observation mode (screen watching). Not every
# chat model is also vision-capable, so this is separate from AI_MODEL.
# Leave blank for a sensible per-provider default.
AI_VISION_MODEL=

# --- Voice (used from Stage 2 onward) ---
WAKE_WORD=hey ev
VOICE_ENABLED=false
# "female" (Microsoft Zira) or "male" (Microsoft David) — which built-in
# Windows voice EV AI speaks with (used when TTS_PROVIDER=pyttsx3, or as
# the automatic fallback if "edge" isn't configured/reachable).
TTS_VOICE=female

# --- TTS backend ---
# "pyttsx3" (default, offline, always works but sounds robotic)
# "edge"    (natural Microsoft Edge neural voice — completely free, no
#            account or key, just needs internet — see EDGE_TTS_VOICE)
TTS_PROVIDER=pyttsx3

# Used only when TTS_PROVIDER=edge. Good natural female voices to try:
# en-US-JennyNeural (calm/friendly), en-US-AriaNeural (warm/expressive).
# Run `edge-tts --list-voices` after installing to see the full list.
EDGE_TTS_VOICE=en-US-JennyNeural
# Negative = slower/softer pacing, e.g. "-10%". "+0%" = normal speed.
EDGE_TTS_RATE=-5%

# --- UI ---
UI_REFRESH_MS=1000
UI_THEME=dark

# --- Database ---
DB_PATH=database/memory.db

# --- Email (Stage 9: send_email tool) ---
# Leave both blank to leave email disabled.
#
# Gmail: 1) turn on 2-Step Verification at myaccount.google.com/security
#        2) go to myaccount.google.com/apppasswords
#        3) create an App Password (pick "Mail" / "Other"), copy the
#           16-character code it gives you — NOT your normal Gmail
#           password, which won't work here.
#        If apppasswords says "The setting you are looking for is not
#        available for your account" even with 2-Step Verification on,
#        Google has App Passwords disabled for that account (common on
#        Workspace/school accounts) — use Outlook below instead.
#
# Outlook/Microsoft 365: 1) turn on 2-step verification at
#                           account.microsoft.com -> Security
#                        2) Security -> Advanced security options ->
#                           App passwords -> create one
#                        3) use the settings in the commented-out block
#                           below instead of the Gmail ones above it.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Gmail (default):
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
# Outlook/Microsoft 365 — uncomment these two and comment out the Gmail
# ones above instead:
# EMAIL_SMTP_HOST=smtp-mail.outlook.com
# EMAIL_SMTP_PORT=587

# --- WhatsApp (Stage 9: send_whatsapp_message tool) ---
# Where EV AI keeps its logged-in WhatsApp Web browser session, so you
# only scan the QR code once. Leave as the default unless you want it
# somewhere else.
WHATSAPP_PROFILE_DIR=data/whatsapp_profile

# --- General browser control (Stage 9: browser_search_google, browser_click, etc.) ---
# Separate persistent session from WhatsApp's.
BROWSER_PROFILE_DIR=data/browser_profile

# --- Face check on startup (Stage 10) ---
# When true, EV AI looks at the webcam when it launches and only opens
# if it recognizes you — otherwise it closes instead of opening. Leave
# false until you've enrolled your face:
#   venv\Scripts\python.exe scripts\enroll_face.py
# then flip this to true. (Re-run that script any time to re-enroll.)
FACE_AUTH_ENABLED=false
FACE_MODEL_DIR=data/face_auth
# LBPH confidence is a *distance* — lower means a closer match. ~70 is a
# forgiving default. Lower it if a stranger gets recognized as you;
# raise it if you keep getting rejected yourself in dim lighting.
FACE_CONFIDENCE_THRESHOLD=70
# How long (seconds) to keep looking for your face before giving up and
# closing.
FACE_AUTH_TIMEOUT=8

# --- Password fallback for the face check (Stage 10) ---
# Not an .env setting — run this once instead:
#   venv\Scripts\python.exe scripts\set_password.py
# If the face scan fails to recognize you (bad lighting, no webcam,
# etc.), the startup screen offers this password instead of just
# closing. Only offered after a face check has actually been tried and
# failed — skip this script and there's no fallback, same as before.

# --- Start automatically at Windows login ---
# Not an .env setting — run this once instead:
#   venv\Scripts\python.exe scripts\install_autostart.py
# (scripts\uninstall_autostart.py undoes it)

# --- Safety ---
# Keep this true. Requires confirmation before destructive actions.
REQUIRE_CONFIRMATION=true

# Optional: a link to a small version file (JSON like {"version": "1.2.0", "url": "...",
# "notes": "..."} or just the version number). Used by Settings -> Check for updates.
# UPDATE_CHECK_URL=
